{
  "name": "nandoapp-backend",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "test": "npm run test:all",
    "test:all": "node --test \"CUSTOM TOOLS/web/operations.test.mjs\" src/*.test.mjs scripts/*.test.mjs",
    "dev": "nodemon app.js",
    "dev:worker": "wrangler dev",
    "d1:migrate:local": "wrangler d1 migrations apply nando-custom-db --local",
    "d1:import:local": "node scripts/import-mysql-dump.mjs",
    "start": "node app.js",
    "build:custom-tools": "vite build --config \"CUSTOM TOOLS/vite.config.mjs\"",
    "test:custom-tools": "node --test \"CUSTOM TOOLS/web/operations.test.mjs\"",
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./public/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./tailwind.input.css -o ./public/tailwind.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "docx": "^9.5.1",
    "jsbarcode": "^3.12.1",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "tailwindcss": "^3.4.19",
    "vite": "^7.1.12",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "^0.35.5"
    }
  }
}
